        "/auth/request-code": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Request SMS code",
                "operationId": "9d7b33afaa8d3d257b1e8b22d310c79e",
                "requestBody": {
                    "description": "Provide All Info Below",
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "phone"
                                ],
                                "properties": {
                                    "phone": {
                                        "type": "string",
                                        "format": "text",
                                        "example": "+37525-222-33-44"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Successful operation"
                    },
                    "409": {
                        "description": "Conflict"
                    },
                    "422": {
                        "description": "Wrong data"
                    }
                }
            }
        },
